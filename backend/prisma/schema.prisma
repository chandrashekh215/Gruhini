datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ROLE_ADMIN
  ROLE_SELLER
  ROLE_USER
}

enum ProductStatus {
  APPROVED
  PENDING
  REJECTED
}

enum OrderStatus {
  PENDING
  DELIVERED
  CANCELLED
  ACCEPTED
  REJECTED
}

enum Category {
  SNACKS
  SWEETS
  VRAT
  THALI
  HANDCRAFTED_ITEMS
}

model Users {
  id               BigInt             @id @default(autoincrement())
  name             String
  email            String             @unique
  contact          String?
  password         String
  role             Role[]             @default([ROLE_USER])
  profileImageUrl String?            @map("profile_image_url")
  fcmToken         String?            @map("fcm_token")
  
  addresses        Address[]
  cart             Cart?
  seller           Seller?
  admin            Admin?
  orderList        Order[]
  resetOtps        PasswordResetOtp[]
  feedback         Feedback[]

  @@map("users")
}

model Address {
  id          BigInt   @id @default(autoincrement())
  addressLine String
  pincode     String
  state       String
  city        String
  userId      BigInt?  @map("user_id")
  user        Users?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller      Seller?  @relation("SellerAddress")
  orders      Order[]

  @@map("addresses")
}

model Seller {
  id              BigInt     @id @default(autoincrement())
  contactNo       String
  isApproved      Boolean    @default(false)
  businessName    String
  userId          BigInt     @unique @map("user_id")
  user            Users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressId       BigInt?    @unique @map("address_id")
  address         Address?   @relation("SellerAddress", fields: [addressId], references: [id])
  categories      Category[]
  totalOrderCount Int        @default(0)
  rating          Float?
  description     String?
  
  products        Product[]
  orders          Order[]
  feedback        Feedback[]

  @@map("sellers")
}

model Product {
  id           BigInt        @id @default(autoincrement())
  name         String
  description  String?
  verified     Boolean       @default(false)
  price        Decimal
  rating       Float?
  badge        String?
  deliveryTime String
  image        String
  status       ProductStatus @default(PENDING)
  category     Category?
  subcategory  String?
  stock        Int           @default(0)
  discount     Float?
  message      String?
  version      Int           @default(0)

  sellerId     BigInt        @map("seller_id")
  seller       Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@map("products")
}

model Cart {
  id        BigInt     @id @default(autoincrement())
  userId    BigInt     @unique @map("userid")
  user      Users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime   @updatedAt @map("updated_at")

  cartItems CartItem[]

  @@map("carts")
}

model CartItem {
  id              BigInt   @id @default(autoincrement())
  cartId          BigInt   @map("cart_id")
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       BigInt   @map("product_id")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int
  priceAtAddTime Decimal  @map("price_at_add_time")

  @@map("cart_items")
}

model Order {
  id              BigInt       @id @default(autoincrement())
  orderStatus     OrderStatus  @default(PENDING)
  deliveryTime    String?
  userId          BigInt       @map("userid")
  user            Users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  placedAt        DateTime     @default(now()) @map("placed_at")
  orderValue      Decimal      @map("order_value")
  message         String?
  sellerId        BigInt       @map("seller_of_order")
  seller          Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  hashedOtp       String?
  expiration      DateTime?
  otpVerified     Boolean      @default(false)
  addressId       BigInt?      @map("address_id")
  deliveryAddress Address?     @relation(fields: [addressId], references: [id])

  orderItemList   OrderItem[]
  feedback        Feedback?

  @@index([sellerId], name: "idx_order_seller_id")
  @@index([userId], name: "idx_order_user_id")
  @@map("orders")
}

model OrderItem {
  id               BigInt   @id @default(autoincrement())
  orderId          BigInt   @map("order_id")
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        BigInt   @map("product_id")
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity         Int
  priceAtOrderTime Decimal  @map("price_at_order_time")

  @@map("order_items")
}

model Feedback {
  id        BigInt   @id @default(autoincrement())
  orderId   BigInt   @unique @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    BigInt   @map("user_id")
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId  BigInt   @map("seller_id")
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feedbacks")
}

model PasswordResetOtp {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt   @map("user_id")
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  otp        String
  expiryTime DateTime @map("expiry_time")
  used       Boolean  @default(false)

  @@map("password_reset_otps")
}

model Admin {
  id     BigInt @id @default(autoincrement())
  userId BigInt @unique @map("user_id")
  user   Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}
