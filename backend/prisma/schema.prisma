datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Users {
  id               Int                @id @default(autoincrement())
  name             String
  email            String             @unique
  contact          String?
  password         String
  role             String             @default("ROLE_USER")
  profileImageUrl String?            @map("profile_image_url")
  fcmToken         String?            @map("fcm_token")
  
  addresses        Address[]
  cart             Cart?
  seller           Seller?
  admin            Admin?
  orderList        Order[]
  resetOtps        PasswordResetOtp[]
  feedback         Feedback[]

  @@map("users")
}

model Address {
  id          Int      @id @default(autoincrement())
  addressLine String
  pincode     String
  state       String
  city        String
  userId      Int?     @map("user_id")
  user        Users?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller      Seller?  @relation("SellerAddress")
  orders      Order[]

  @@map("addresses")
}

model Seller {
  id              Int        @id @default(autoincrement())
  contactNo       String
  isApproved      Boolean    @default(false)
  businessName    String
  userId          Int        @unique @map("user_id")
  user            Users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressId       Int?       @unique @map("address_id")
  address         Address?   @relation("SellerAddress", fields: [addressId], references: [id])
  categories      String     @default("THALI")
  totalOrderCount Int        @default(0)
  rating          Float?
  description     String?
  
  products        Product[]
  orders          Order[]
  feedback        Feedback[]

  @@map("sellers")
}

model Product {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  verified     Boolean    @default(false)
  price        Float
  rating       Float?
  badge        String?
  deliveryTime String
  image        String
  status       String     @default("PENDING")
  category     String?
  subcategory  String?
  stock        Int        @default(0)
  discount     Float?
  message      String?
  version      Int        @default(0)

  sellerId     Int        @map("seller_id")
  seller       Seller     @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@map("products")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique @map("userid")
  user      Users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime   @updatedAt @map("updated_at")

  cartItems CartItem[]

  @@map("carts")
}

model CartItem {
  id              Int      @id @default(autoincrement())
  cartId          Int      @map("cart_id")
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       Int      @map("product_id")
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Int
  priceAtAddTime Float    @map("price_at_add_time")

  @@map("cart_items")
}

model Order {
  id              Int          @id @default(autoincrement())
  orderStatus     String       @default("PENDING")
  deliveryTime    String?
  userId          Int          @map("userid")
  user            Users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  placedAt        DateTime     @default(now()) @map("placed_at")
  orderValue      Float        @map("order_value")
  message         String?
  sellerId        Int          @map("seller_of_order")
  seller          Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  hashedOtp       String?
  expiration      DateTime?
  otpVerified     Boolean      @default(false)
  addressId       Int?         @map("address_id")
  deliveryAddress Address?     @relation(fields: [addressId], references: [id])

  orderItemList   OrderItem[]
  feedback        Feedback?

  @@index([sellerId], name: "idx_order_seller_id")
  @@index([userId], name: "idx_order_user_id")
  @@map("orders")
}

model OrderItem {
  id               Int      @id @default(autoincrement())
  orderId          Int      @map("order_id")
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        Int      @map("product_id")
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity         Int
  priceAtOrderTime Float    @map("price_at_order_time")

  @@map("order_items")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId  Int      @map("seller_id")
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("feedbacks")
}

model PasswordResetOtp {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  otp        String
  expiryTime DateTime @map("expiry_time")
  used       Boolean  @default(false)

  @@map("password_reset_otps")
}

model Admin {
  id     Int   @id @default(autoincrement())
  userId Int   @unique @map("user_id")
  user   Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}
